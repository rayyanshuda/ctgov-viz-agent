# Copy to .env and fill in. This is required, otherwise the service will not start a plan without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown: check app/config.py for all the configurations)
# CTGOV_VIZ_MODEL=claude-opus-5
# CTGOV_VIZ_MAX_STUDIES=5000
# CTGOV_VIZ_CACHE_DIR=.cache
# CTGOV_VIZ_CACHE_TTL_SECONDS=86400
# CTGOV_VIZ_HTTP_TIMEOUT_SECONDS=30

# Optional: turn on saved charts (history, share links, refresh). Leave unset to run without a
# database. Then create the table once with:  uv run alembic upgrade head
# (With Docker you can skip this: docker-compose.yml sets the database URL and migrates for you.)
# CTGOV_VIZ_DATABASE_URL=postgresql://user:password@localhost:5432/ctgov_viz

# Optional, Docker only: the token for the Cloudflare Tunnel that publishes the app at a public URL.
# Used by:  docker compose --profile public up -d --build
# CLOUDFLARE_TUNNEL_TOKEN=eyJ...
